from pathlib import Path

import socketio

from ...core import schemas
from ...api.v1.state import state
from ...core.logger import logger
from ...core.auth import socket_auth
from ...core.sockets import socket_namespace, socket_event


@socket_namespace("/v1")
class SocketV1Namespace(socketio.AsyncNamespace):
    room = None

    @socket_auth
    async def on_connect(self, sid, environ, _auth):
        pass

    async def on_disconnect(self, _sid, _reason):
        pass

    @socket_event(
        name="join",
        payload=schemas.SocketJoinPayload,
        response=schemas.SocketJoinPayload,
        response_event="joined",
        join_room=True,
        room_arg="room",
    )
    async def on_join(self, _sid, data: schemas.SocketJoinPayload):
        self.room = data.room

    @socket_event("set_data", payload=str, response=str, response_event="set_data", broadcast=room)
    async def on_set_data(self, _sid, data):
        state.data = data
        return data

    @socket_event("get_state", response=dict, ack=True, key_builder=lambda: {}, cache_enabled=True)
    async def on_get_state(self, _sid):
        return state.to_dict()


def configure_v1_namespace():
    logger.info("Configured V1 namespace")